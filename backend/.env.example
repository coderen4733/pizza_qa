# CORS 관련 (JSON 배열 형식)
CORS_ORIGINS=["http://localhost:3000"]

# JWT 관련
JWT_ALGORITHM=HS256
ACCESS_TOKEN_SECRET=32자-이상의-랜덤-문자열
REFRESH_TOKEN_SECRET=32자-이상의-랜덤-문자열(ACCESS와-다르게)
ACCESS_TOKEN_EXPIRE=30
REFRESH_TOKEN_EXPIRE=1

# DB(Supabase - Postgres DB) 관련
DB_URL=postgresql://사용자:비밀번호@호스트:5432/postgres
DB_ECHO=false

# S3(AWS) 관련

# Redis(Cloud) 관련 - 선택 (아직 미사용)
REDIS_URL=

# Vector DB(Qdrant) 관련 - 선택 (아직 미사용)
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=pizza
VECTOR_DB_TIMEOUT=10
